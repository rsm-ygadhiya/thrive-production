# Copy to backend/.env and fill in real values for local dev.
# backend/.env is gitignored — never commit real secrets.
#
# Loaded automatically by config/settings.py's tiny stdlib loader; real
# exported env vars always take precedence over values in this file.

# Required for THRIVE_LLM=tritonai (the default). Get a key from
# https://tritonai-api.ucsd.edu/ with your UCSD login (may require campus
# network / VPN off-campus).
TRITONAI_API_KEY=

# ChatGPT/Codex OAuth mode (no OpenAI Platform API key required).
# Authenticate once on a secure interactive machine, then provision the
# resulting credential file to the chatbot host as a secret.
THRIVE_LLM=codex
CODEX_MODEL=gpt-5.4
CODEX_CREDENTIALS_PATH=/run/secrets/openai-codex-oauth.json
CODEX_ALLOW_BROWSER_LOGIN=0

# Codex OAuth provides completions, not embeddings. Use the local embedding
# model for the repository's RAG retrieval layer.
THRIVE_EMBEDDINGS=local

# Optional overrides — defaults live in config/settings.py.
# Keys are reissued with DIFFERENT model sets; check /v1/models before trusting
# any id below. As of 2026-09-11 the key serves gpt-5-mini, gpt-5.4,
# gemini-3.5-flash and claude-sonnet-5 -- and gpt-5.4 does NOT work through
# chat completions (the gateway sends it to Azure's Responses API).
# TRITONAI_MODEL=claude-sonnet-5
# The model the Resources bot's question reading runs on. gemini-3.5-flash
# reads it as well as claude-sonnet-5 and about twice as fast. The planner's
# reading and every answer stay on TRITONAI_MODEL.
# TRITONAI_READER_MODEL=gemini-3.5-flash
# TRITONAI_EMBED_MODEL=api-tgpt-embeddings   # no embedding model on this key

# Optional: MS Graph (Outlook) calendar sync for advisors. Blank/unset means
# the feature is off and appointments behave exactly as without it (ICS +
# Zoom only). All three of CLIENT_ID/TENANT_ID/CLIENT_SECRET must be set
# together to enable it (see graph_enabled() in services/graph.py).
# MS_GRAPH_CLIENT_ID=
# MS_GRAPH_TENANT_ID=
# MS_GRAPH_CLIENT_SECRET=
# MS_GRAPH_REDIRECT_URI=http://localhost:8000/api/thrive/calendar/callback
# MS_GRAPH_SCOPES=Calendars.ReadWrite offline_access User.Read

# Who runs a web search for backends that cannot ("duckduckgo" | "brave" |
# "serper" | "tavily" | "none"). Only THRIVE_LLM=codex searches natively; on
# tritonai this is the only thing standing between "grounded in current
# postings" and the model's training data. duckduckgo needs no key.
# An ordered list, tried until one answers -- a keyed provider stops at a quota,
# the keyless one rate-limits by address and recovers on its own.
# THRIVE_SEARCH=tavily,duckduckgo
# THRIVE_SEARCH_API_KEY=
